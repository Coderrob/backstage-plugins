    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.32.3",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.20.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jscpd": "^4.0.5",
    "madge": "^8.0.0",
    "make-coverage-badge": "^1.2.0",
    "node-gyp": "^10.0.0",
    "prettier": "^3.5.0",
    "rollup": "^4.34.6",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "webpack": "~5.104.1"
  },
  "engines": {
    "node": ">=20",
    "yarn": ">=4.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/Coderrob/typescript-template",
  "keywords": [],
  "license": "Apache-2.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "main": "./dist/index.mjs",
  "name": "your-project-name",
  "optionalDependencies": {
    "pino-pretty": "^13.1.1"
  },
  "packageManager": "yarn@4.5.3",
  "prettier": "@backstage/cli/config/prettier",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coderrob/typescript-template.git"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "all": "yarn lint:fix && yarn quality && yarn test && yarn package",
    "build": "backstage-cli repo build --all",
    "build:backend": "yarn workspace backend build",
    "build:image": "yarn workspace backend build-image",
    "clean": "backstage-cli repo clean",
    "copyright": "sh ./script/copyright ./src",
    "coverage": "make-coverage-badge --output-path ./badges/coverage.svg",
    "duplication": "jscpd plugins",
    "fix": "backstage-cli repo fix",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "madge": "madge --circular --orphans plugins",
    "new": "backstage-cli new",
    "quality": "yarn lint && yarn duplication && yarn madge",
    "start": "backstage-cli repo start",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.1",
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  }
}
